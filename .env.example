# ==============================================================================
# PaisaFlow Environment Configuration
# Copy this file to `.env` for local development. Never commit real secrets.
# ==============================================================================

# --- Server-Side Secrets (never exposed to browser) ---------------------------
# Required for the AI Financial Assistant (/api/v1/ai/chat).
# Configured automatically in AI Studio via Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL where the application is hosted (injected in Cloud Run / AI Studio).
APP_URL="MY_APP_URL"

# Server listening port (defaults to 3000 in AI Studio container).
PORT="3000"

# --- Client-Side Public Variables (must start with VITE_) ---------------------
# Optional API base URL override (defaults to same-origin `/api/v1`).
VITE_API_BASE_URL="/api/v1"

# Optional Supabase cloud persistence credentials.
# When omitted, PaisaFlow runs with isolated local browser persistence.
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-key"
